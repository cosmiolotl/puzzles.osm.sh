{
  "name": "puzzles",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "new-issue": "bun scripts/new-issue.ts",
    "check:puzzles": "node --experimental-strip-types scripts/check-puzzles.ts",
    "chess:great-moves": "node --experimental-strip-types scripts/chess/find-great-moves.ts",
    "db:migrate:local": "wrangler d1 migrations apply puzzles --local",
    "db:migrate": "wrangler d1 migrations apply puzzles --remote"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@radix-ui/react-slot": "^1.2.3",
